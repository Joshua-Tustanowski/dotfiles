#!/usr/bin/env bash

# Bash prompt matching oh-my-zsh's robbyrussell theme.

if tput setaf 1 &> /dev/null; then
	reset="\[$(tput sgr0)\]";
	green="\[$(tput bold)$(tput setaf 2)\]";
	red="\[$(tput setaf 1)\]";
	bold_red="\[$(tput bold)$(tput setaf 1)\]";
	cyan="\[$(tput setaf 6)\]";
	blue="\[$(tput setaf 4)\]";
	bold_blue="\[$(tput bold)$(tput setaf 4)\]";
	yellow="\[$(tput setaf 3)\]";
else
	reset='\[\e[0m\]';
	green='\[\e[1;32m\]';
	red='\[\e[0;31m\]';
	bold_red='\[\e[1;31m\]';
	cyan='\[\e[0;36m\]';
	blue='\[\e[0;34m\]';
	bold_blue='\[\e[1;34m\]';
	yellow='\[\e[0;33m\]';
fi;

prompt_git() {
	git rev-parse --is-inside-work-tree &> /dev/null || return;

	local branch dirty='';
	branch="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
		git describe --all --exact-match HEAD 2> /dev/null || \
		git rev-parse --short HEAD 2> /dev/null)" || return;

	if ! git diff-index --quiet HEAD -- 2> /dev/null || [ -n "$(git ls-files --others --exclude-standard 2> /dev/null)" ]; then
		dirty=" ${yellow}✗";
	fi;

	printf ' %sgit:(%s%s%s)%s%s' "$bold_blue" "$red" "$branch" "$bold_blue" "$dirty" "$reset";
}

set_bash_prompt() {
	local exit_code=$? arrow="$green";
	[ "$exit_code" -ne 0 ] && arrow="$bold_red";

	PS1="\[\033]0;\W\007\]${arrow}➜  ${cyan}\W${reset}$(prompt_git) ";
}

PROMPT_COMMAND=set_bash_prompt;

PS2="${yellow}→ ${reset}";
export PS2;
